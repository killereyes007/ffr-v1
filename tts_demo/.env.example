# Copy this file to .env and insert your own private OpenRouter key.
OPENROUTER_API_KEY=replace_with_your_new_key
OPENROUTER_MODEL=openrouter/auto
# Optional. Set this to a local adapted-model directory, for example:
# FON_TTS_MODEL=models/inference_model-speaker4-20261029
# Optional. By default, consented training examples are stored in
# ~/fon-assistant-training-data, outside this project.
# FON_DATASET_DIR=/path/to/private/fon-training-data
# Optional. Use the URL of your local app if OpenRouter requests a referer.
# OPENROUTER_HTTP_REFERER=http://localhost:7861
